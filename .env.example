# Process timezone must be UTC so MySQL DATETIME stores OddsPapi UTC instants.
# UI converts to Africa/Addis_Ababa (UTC+3) for Ethiopian users.
TZ=UTC

# MySQL
DATABASE_URL=mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/maraki_bet

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001
CASHIER_ORIGIN=http://localhost:3002
AGENT_ORIGIN=http://localhost:3003
INTERNAL_TOKEN=change-me

# OddsPapi — never expose this key to the browser
ODDSPAPI_API_KEY=
ODDSPAPI_BASE_URL=https://api.oddspapi.io
ODDSPAPI_WS_URL=wss://v5.oddspapi.io/ws
ODDSPAPI_LANG=en
ODDSPAPI_ENABLE_WS=false

# Pricing / ingest
SOURCE_BOOKMAKER=pinnacle+30
HOUSE_MARGIN=0.06
FIXTURE_SYNC_DAYS=28
SPORT_IDS=10
CATALOG_SYNC_ON_START=false
ENABLE_ODDSPAPI_POLL=false
ODDSPAPI_POLL_INTERVAL_MS=30000
# Cap odds pulls per sync to protect OddsPapi quota (raise only when needed).
MAX_ODDS_TOURNAMENTS=25
ODDS_TOURNAMENT_BATCH_SIZE=1
ODDS_EMPTY_STOP_AFTER=3
ODDS_VERBOSITY=2
